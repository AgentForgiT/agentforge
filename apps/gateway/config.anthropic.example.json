{
  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "log_level": "INFO"
  },
  "models": {
    "mock-coder": {
      "provider": "mock",
      "provider_model": "mock-coder-v1"
    },
    "anthropic-sonnet": {
      "provider": "anthropic",
      "provider_model": "claude-sonnet-4-5"
    }
  },
  "providers": {
    "mock": {
      "type": "mock"
    },
    "anthropic": {
      "type": "anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY",
      "timeout_seconds": 60
    }
  }
}
